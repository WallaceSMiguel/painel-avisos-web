# ===== Copie para .env e preencha =====

# Domínio do painel (o DNS dele precisa apontar para este servidor)
DOMINIO=painel.valorizacao.com

# Primeiro acesso ao /admin (depois troque a senha pelo próprio painel)
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-esta-senha

# Tamanho máximo de cada vídeo/imagem enviado (MB)
MAX_UPLOAD_MB=2048

# Velocidade x qualidade da conversão de vídeo: veryfast | fast | medium
FFMPEG_PRESET=veryfast

FUSO_HORARIO=America/Sao_Paulo
