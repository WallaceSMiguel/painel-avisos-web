{
  "manifest_version": 3,
  "name": "Leitor do Messenger - Painel da TV",
  "version": "1.1.0",
  "description": "Envia os atendimentos pendentes do Messenger (Onvio/Gestta) para o painel da TV.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://app.gestta.com.br/*",
    "https://painelcorporativo.pythonanywhere.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://app.gestta.com.br/*"],
      "js": ["conteudo.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "opcoes.html",
  "action": { "default_title": "Leitor do Messenger", "default_popup": "opcoes.html" }
}
